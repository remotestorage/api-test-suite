# Target remoteStorage Internet-Draft (03 through 27).
draft_version: 27
# Optional complete WebFinger URL, including the resource query parameter.
# Use only webfinger_url to select the advertised draft automatically.
# webfinger_url: https://example.org/.well-known/webfinger?resource=acct%3Atest%40example.org
# Storage base URL for RS test user (as it appears in Webfinger response)
storage_base_url: https://storage.5apps.com/rs-test
# Storage base URL for a different user (with no access for RS user)
storage_base_url_other: https://storage.5apps.com/rs-test-other
# RS category (base folder) name
category: api-test
# OAuth access token with read-write access to the above category
token: 123456abcdef
# OAuth access token with read-only access to the above category
read_only_token: 123456abcdef
# OAuth access token with access to all categories
root_token: 123456abcdef
